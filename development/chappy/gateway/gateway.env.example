# Copy to ../runtime/gateway.env. Do not commit the real file.
CHAPPY_BACKEND=mock
CHAPPY_AUTH=chatgpt
CHAPPY_GATEWAY_TOKEN=replace-with-a-random-secret-at-least-32-characters
CHAPPY_PORT=18765
# For ChatGPT login, run scripts/login-chatgpt.ps1, then use CHAPPY_BACKEND=codex.
# CHAPPY_MODEL is optional: omitted means the Codex account default.
# CHAPPY_REASONING_EFFORT=max
# To use API key billing explicitly, set CHAPPY_AUTH=apikey and OPENAI_API_KEY.
# CHAPPY_BACKEND=codex
# CHAPPY_MODEL=your-api-model-id
# OPENAI_API_KEY=your-key
# On Windows use the installed native codex.exe, not codex.ps1 or codex.cmd.
# CHAPPY_CODEX_BIN=C:/path/to/codex.exe
