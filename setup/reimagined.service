[Unit]
Description=Reimagined Minecraft NeoForge Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/reimagined
ExecStart=/opt/reimagined/start-server.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGINT
SuccessExitStatus=0 130 143
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
